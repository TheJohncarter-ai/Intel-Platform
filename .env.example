# ─────────────────────────────────────────────────────────────
# RAILWAY — add all of these in your Railway service's Variables
# ─────────────────────────────────────────────────────────────

# ── Provided automatically by Railway when you add a MySQL service ──
DATABASE_URL=mysql://user:password@host:3306/railway

# ── Generate a strong random string (e.g. openssl rand -hex 32) ──
JWT_SECRET=replace_with_a_long_random_secret

# ── From your Manus project settings ──
# Found in Manus → Project → Settings → App Credentials
VITE_APP_ID=your_manus_app_id
VITE_OAUTH_PORTAL_URL=https://auth.manus.space
OAUTH_SERVER_URL=https://api.manus.space

# ── Your personal Manus OpenID (the platform owner / admin account) ──
# Sign into Manus, go to Profile → copy your OpenID
OWNER_OPEN_ID=your_manus_open_id

# ── Set automatically by Railway; do not change ──
NODE_ENV=production

# ── Optional: AI research feature (leave blank to disable) ──
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
